// Prisma schema for GradeChange AI
// Persistent store for operator feedback, scenario runs, and model metrics.
// SQLite is used so the deployment remains single-file and zero-config —
// suitable for an on-prem edge box adjacent to the Honeywell QCS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single Accept/Reject decision made by an operator. These rows feed the
/// periodic retraining job and the audit-trail UI.
model FeedbackLog {
  id              String   @id @default(cuid())
  // The recommendation ID this decision applies to (generated by the engine)
  recommendationId String
  // "Accepted" | "Rejected"
  action          String
  // Required when action = "Rejected"; one of the canonical reject reasons
  rejectReason    String?
  // Operator note (free text)
  note            String?
  // Process inputs at the moment of the decision
  stockFlow       Float
  fillerFlow      Float
  steamPressure   Float
  machineSpeed    Float
  // Engine outputs at the moment of the decision
  riskProb        Float
  bwTarget        Float
  actualBw        Float
  deviationPct    Float
  isOffSpec       Boolean
  // Setpoints the engine suggested
  suggestedStockFlow     Float?
  suggestedMachineSpeed  Float?
  // If accepted, the setpoints actually applied to the DCS
  appliedStockFlow       Float?
  appliedMachineSpeed    Float?
  // Audit
  operatorId      String   @default("operator-1")
  lineId          String   @default("PM-04")
  createdAt       DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([recommendationId])
}

/// A grade-change scenario execution — captures the start/end state and the
/// outcome (within-spec / off-spec / aborted). Powers the historical KPIs.
model ScenarioRun {
  id              String   @id @default(cuid())
  scenarioId      String   // e.g. "A-to-B", "B-to-C"
  scenarioName    String
  severity        String   // "stable" | "warning" | "critical"
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  startStockFlow  Float
  startSteamPressure Float
  startMachineSpeed  Float
  endStockFlow    Float?
  endSteamPressure Float?
  endMachineSpeed  Float?
  // Outcome
  peakDeviationPct Float?
  stabilizationMin Float?
  outcome         String?  // "within-spec" | "off-spec" | "aborted"
  operatorId      String   @default("operator-1")
  lineId          String   @default("PM-04")

  @@index([scenarioId])
  @@index([startedAt])
  @@index([outcome])
}

/// Aggregated model quality metrics, appended each time the model is
/// retrained (i.e. each time an Accept triggers a feedback cycle).
model ModelMetric {
  id              String   @id @default(cuid())
  retrainCount    Int
  // Snapshot of validation metrics at this retrain cycle
  auc             Float
  precision       Float
  recall          Float
  f1              Float
  // Data-volume snapshot
  trainingSamples Int
  feedbackSamples Int
  // Top feature importances serialised as JSON
  featureImportance String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/// A live process sample (ring-buffer style). We persist a 24h rolling window
/// for replay / debugging. The WebSocket mini-service writes here, and the
/// REST API reads from here for historical queries.
model ProcessSample {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  stockFlow       Float
  fillerFlow      Float
  steamPressure   Float
  machineSpeed    Float
  bwTarget        Float
  actualBw        Float
  deviationPct    Float
  isOffSpec       Boolean
  riskProb        Float
  lineId          String   @default("PM-04")

  @@index([timestamp])
  @@index([lineId, timestamp])
}
